# Cloudflare Pages response headers. Vite puts a content hash in every file name under /_astro/,
# so those can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# streaming compilation (WebAssembly.compileStreaming) requires this exact type
/_astro/*.wasm
  Content-Type: application/wasm

# the RDKit bundle (rdkit.tar.gz, renamed rdkit.tar-<hash>.gz by Vite) and PGlite's data file are
# unpacked by PGlite itself, so they must arrive as-is, never with Content-Encoding: gzip
/_astro/*.gz
  Content-Type: application/gzip
/_astro/*.data
  Content-Type: application/octet-stream

# Everything runs in the page; the only other origin is the Umami analytics server, for its script
# and the events it sends (see /privacy/). 'wasm-unsafe-eval' allows compiling WebAssembly;
# molecule SVGs are shown as data: images, and Vite inlines small font subsets as data: URLs.
# COOP/COEP aren't needed: PGlite doesn't use SharedArrayBuffer.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://umami.cheminfo.dev 'wasm-unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://umami.cheminfo.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
