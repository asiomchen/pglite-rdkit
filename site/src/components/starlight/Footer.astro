---
// Starlight's footer with the copyright and a privacy link in its meta row, instead of a second
// block below it (the meta row is otherwise empty here: no edit links, no last-updated dates).
import EditLink from '@astrojs/starlight/components/EditLink.astro'
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro'
import Pagination from '@astrojs/starlight/components/Pagination.astro'

// the build year, so the line stays current with every deploy
const year = new Date().getFullYear()
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
    <p class="legal">
      Copyright © {year} Anton Siomchen<span class="print:hidden"> · <a href="/privacy/">Privacy</a></span>
    </p>
  </div>
  <Pagination />
</footer>

<style>
  footer {
    flex-direction: column;
    gap: 1.5rem;
  }
  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .legal {
    margin-inline: auto;
    font-size: var(--sl-text-xs);
  }
  .legal a {
    color: inherit;
    text-decoration: none;
  }
  .legal a:hover {
    color: var(--sl-color-white);
  }
</style>
